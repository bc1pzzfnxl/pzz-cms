---
import { env } from "cloudflare:workers";
import { createContent } from "@pzz-cms/core";
import AdminLayout from "../../layouts/AdminLayout.astro";

const content = createContent(env.DB);
const [stats, attention] = await Promise.all([content.getStats(), content.getAttention()]);

const formatDate = (dateStr: string | null) => {
  if (!dateStr) return "";
  const date = new Date(dateStr);
  return Number.isNaN(date.getTime())
    ? dateStr
    : new Intl.DateTimeFormat("en", { day: "numeric", month: "short" }).format(date);
};

const formatMonth = (month: string) => {
  const date = new Date(`${month}-01T00:00:00Z`);
  return Number.isNaN(date.getTime())
    ? month
    : new Intl.DateTimeFormat("en", { month: "short", timeZone: "UTC" }).format(date);
};

const plural = (count: number, one: string, many: string) =>
  `${count} ${count === 1 ? one : many}`;

// Chart geometry (Amicro mono-charts style: mono bars, dashed grid, no chrome).
const months = stats.publicationsByMonth;
const chartWidth = 520;
const baseline = 150;
const chartHeight = 112;
const maxCount = Math.max(1, ...months.map((entry) => entry.count));
const slot = months.length > 0 ? chartWidth / months.length : chartWidth;
const bars = months.map((entry, index) => {
  const height = Math.max(4, Math.round((entry.count / maxCount) * chartHeight));
  return {
    label: formatMonth(entry.month),
    count: entry.count,
    x: Math.round(slot * index + slot / 2 - 19),
    y: baseline - height,
    height,
  };
});

const totalArticles = stats.articles.published + stats.articles.draft;
const categories = stats.byCategory.slice(0, 4);
const maxCategory = Math.max(1, ...categories.map((category) => category.count));

const issues = [
  {
    count: attention.missingDescription,
    label: "published with no description",
    href: "/admin/articles/?status=published",
  },
  {
    count: attention.missingCover,
    label: "published with no cover image",
    href: "/admin/articles/?status=published",
  },
  {
    count: attention.orphanMedia,
    label: "media files nothing references",
    href: "/admin/media/",
  },
].filter((issue) => issue.count > 0);

const nothingToFix = issues.length === 0 && attention.staleDraftCount === 0;
---

<AdminLayout title="Overview">
    <div class="mb-7 flex items-end justify-between gap-4">
        <div>
            <h1 class="text-[24px] font-semibold tracking-tight">Overview</h1>
            <p class="mt-1 text-sm text-muted-foreground">
                {totalArticles} articles · {stats.media} media · {stats.categories} categories
            </p>
        </div>
        <a href="/admin/new/" class="btn btn-primary">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M12 5v14M5 12h14"></path>
            </svg>
            New article
        </a>
    </div>

    <div class="card mb-4 p-5">
        <div class="flex items-center justify-between">
            <div class="text-[15px] font-medium">Needs attention</div>
            {attention.staleDraftCount > 0 && (
                <span class="text-[12.5px] text-muted-foreground">
                    {plural(attention.staleDraftCount, "stale draft", "stale drafts")}
                </span>
            )}
        </div>

        {nothingToFix ? (
            <p class="mt-2 text-sm text-muted-foreground">Nothing needs attention.</p>
        ) : (
            <div class="mt-3 grid grid-cols-2 gap-x-6 gap-y-3">
                {attention.staleDraftCount > 0 && (
                    <div>
                        <div class="flex items-baseline gap-2">
                            <span class="text-[15px] font-semibold">{attention.staleDraftCount}</span>
                            <span class="text-[13px]">untouched for 30+ days</span>
                        </div>
                        <ul class="mt-1.5 space-y-1">
                            {attention.staleDrafts.map((draft) => (
                                <li class="flex items-baseline gap-2 text-[13px]">
                                    <a href={`/admin/${draft.id}`} class="truncate hover:underline">
                                        {draft.title}
                                    </a>
                                    <span class="shrink-0 text-xs text-muted-foreground">
                                        {formatDate(draft.updatedAt)}
                                    </span>
                                </li>
                            ))}
                        </ul>
                    </div>
                )}
                <div class="space-y-1.5">
                    {issues.map((issue) => (
                        <div class="flex items-baseline gap-2 text-[13px]">
                            <span class="font-semibold">{issue.count}</span>
                            <span>{issue.label}</span>
                            <a href={issue.href} class="ml-auto shrink-0 text-xs hover:underline">
                                Review
                            </a>
                        </div>
                    ))}
                </div>
            </div>
        )}
    </div>

    <div class="grid grid-cols-4 gap-4">
        <div class="card p-5">
            <div class="flex items-center justify-between text-[13.5px] text-muted-foreground">
                Published articles
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.75">
                    <path d="M20 6 9 17l-5-5"></path>
                </svg>
            </div>
            <div class="stat-value mt-2.5">{stats.articles.published}</div>
            <div class="mt-1.5 text-[12.5px] text-muted-foreground">of {totalArticles} articles</div>
        </div>
        <div class="card p-5">
            <div class="flex items-center justify-between text-[13.5px] text-muted-foreground">
                Drafts
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.75">
                    <path d="M12 20h9"></path>
                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path>
                </svg>
            </div>
            <div class="stat-value mt-2.5">{stats.articles.draft}</div>
            <div class="mt-1.5 text-[12.5px] text-muted-foreground">to review and publish</div>
        </div>
        <div class="card p-5">
            <div class="flex items-center justify-between text-[13.5px] text-muted-foreground">
                Documents
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
                    <path d="M4 6h6l2 2h8v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6z"></path>
                </svg>
            </div>
            <div class="stat-value mt-2.5">{stats.documents.published + stats.documents.draft}</div>
            <div class="mt-1.5 text-[12.5px] text-muted-foreground">{plural(stats.documents.draft, "draft", "drafts")}</div>
        </div>
        <div class="card p-5">
            <div class="flex items-center justify-between text-[13.5px] text-muted-foreground">
                Media
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.75">
                    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <path d="m21 15-5-5L5 21"></path>
                </svg>
            </div>
            <div class="stat-value mt-2.5">{stats.media}</div>
            <div class="mt-1.5 text-[12.5px] text-muted-foreground">images on R2</div>
        </div>
    </div>

    <div class="mt-4 grid grid-cols-3 gap-4">
        <div class="card col-span-2 p-6">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-[15px] font-medium">Publications per month</div>
                    <div class="mt-0.5 text-[12.5px] text-muted-foreground">Last 6 months</div>
                </div>
                <div class="flex items-center gap-1.5 text-[12.5px] text-muted-foreground">
                    <span class="h-2 w-2 rounded-sm bg-primary"></span>Published
                </div>
            </div>
            {
                months.length > 0 ? (
                    <svg viewBox="0 0 520 180" class="mt-5 w-full" role="img" aria-label="Publications per month">
                        <g stroke="var(--border)" stroke-width="1" stroke-dasharray="3 5">
                            <line x1="0" y1="24" x2="520" y2="24" />
                            <line x1="0" y1="66" x2="520" y2="66" />
                            <line x1="0" y1="108" x2="520" y2="108" />
                            <line x1="0" y1="150" x2="520" y2="150" />
                        </g>
                        {bars.map((bar, index) => (
                            <>
                                <rect
                                    x={bar.x}
                                    y={bar.y}
                                    width={38}
                                    height={bar.height}
                                    rx={5}
                                    fill="var(--primary)"
                                    opacity={0.45 + (index / Math.max(1, bars.length - 1)) * 0.55}
                                />
                                <text
                                    x={bar.x + 19}
                                    y={bar.y - 8}
                                    fill="var(--foreground)"
                                    font-size="12"
                                    font-weight="600"
                                    text-anchor="middle"
                                >
                                    {bar.count}
                                </text>
                                <text
                                    x={bar.x + 19}
                                    y={169}
                                    fill="var(--muted-foreground)"
                                    font-size="11.5"
                                    text-anchor="middle"
                                >
                                    {bar.label}
                                </text>
                            </>
                        ))}
                    </svg>
                ) : (
                    <p class="mt-6 text-sm text-muted-foreground">
                        Nothing published yet. The chart appears with the first publication.
                    </p>
                )
            }
        </div>

        <div class="card p-6">
            <div class="text-[15px] font-medium">By category</div>
            {categories.length > 0 ? (
                <div class="mt-4 space-y-3.5">
                    {categories.map((category) => (
                        <div>
                            <div class="mb-1.5 flex justify-between text-[13px]">
                                <span>{category.name}</span>
                                <span class="text-muted-foreground">{category.count}</span>
                            </div>
                            <div class="h-1.5 rounded-full bg-muted">
                                <div
                                    class="h-1.5 rounded-full bg-primary"
                                    style={`width: ${Math.max(2, Math.round((category.count / maxCategory) * 100))}%`}
                                />
                            </div>
                        </div>
                    ))}
                </div>
            ) : (
                <p class="mt-4 text-sm text-muted-foreground">No categories.</p>
            )}
            <a href="/admin/categories/" class="btn btn-outline btn-sm mt-5 w-full">Manage categories</a>
        </div>
    </div>

    <div class="card mt-4">
        <div class="flex items-center justify-between border-b px-5 py-3.5">
            <div class="text-[15px] font-medium">Latest articles</div>
            <a href="/admin/articles/" class="btn btn-ghost btn-sm">View all</a>
        </div>
        {
            stats.recent.length > 0 ? (
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Status</th>
                            <th class="text-right">Updated</th>
                        </tr>
                    </thead>
                    <tbody>
                        {stats.recent.map((article) => (
                            <tr>
                                <td>
                                    <a href={`/admin/${article.id}`} class="font-medium hover:underline">
                                        {article.title}
                                    </a>
                                    <div class="mt-0.5 text-xs text-muted-foreground">/{article.slug}/</div>
                                </td>
                                <td>
                                    {article.status === "published" ? (
                                        <span class="badge badge-published">published</span>
                                    ) : (
                                        <span class="badge badge-draft">draft</span>
                                    )}
                                </td>
                                <td class="text-right text-muted-foreground">{formatDate(article.updatedAt)}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            ) : (
                <p class="p-5 text-sm text-muted-foreground">No articles.</p>
            )
        }
    </div>
</AdminLayout>
