---
import { env } from "cloudflare:workers";
import { createContent } from "@pzz-cms/core";
import DocumentUpload from "../../../components/admin/DocumentUpload";
import AdminLayout from "../../../layouts/AdminLayout.astro";

const content = createContent(env.DB);
const documents = await content.listDocuments();

const formatDate = (dateStr: string | null) => {
  if (!dateStr) return "";
  const date = new Date(dateStr);
  return Number.isNaN(date.getTime())
    ? dateStr
    : new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "short", year: "numeric" }).format(date);
};

const published = documents.filter((document) => document.status === "published").length;
const drafts = documents.length - published;
---

<AdminLayout title="Documents">
    <div class="mb-7 flex items-end justify-between gap-4">
        <div>
            <h1 class="text-[24px] font-semibold tracking-tight">Documents</h1>
            <p class="mt-1 text-sm text-muted-foreground">
                Pages JSON (hors articles) · {documents.length} documents · {drafts} brouillon(s)
            </p>
        </div>
        <DocumentUpload client:load />
    </div>

    <div class="card overflow-hidden">
        {
            documents.length > 0 ? (
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Titre</th>
                            <th>Slug</th>
                            <th>Statut</th>
                            <th>Modifié</th>
                            <th class="w-[100px]" />
                        </tr>
                    </thead>
                    <tbody>
                        {documents.map((document) => (
                            <tr>
                                <td>
                                    <a href={`/admin/documents/${document.id}`} class="font-medium hover:underline">
                                        {document.title}
                                    </a>
                                </td>
                                <td class="font-mono text-xs text-muted-foreground">/{document.slug}/</td>
                                <td>
                                    {document.status === "published" ? (
                                        <span class="badge badge-published">publié</span>
                                    ) : (
                                        <span class="badge badge-draft">brouillon</span>
                                    )}
                                </td>
                                <td class="text-muted-foreground">{formatDate(document.updatedAt)}</td>
                                <td class="text-right">
                                    <a href={`/admin/documents/${document.id}`} class="btn btn-ghost btn-sm">
                                        Modifier
                                    </a>
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            ) : (
                <p class="p-6 text-sm text-muted-foreground">Aucun document. Importe un fichier .json.</p>
            )
        }
    </div>

    <p class="mt-3 text-[13px] text-muted-foreground">
        Chaque document est servi sur <code>/&lt;slug&gt;/</code> ; un brouillon renvoie 404.
    </p>
</AdminLayout>
