---
import { env } from "cloudflare:workers";
import DocumentEditor from "../../../components/admin/DocumentEditor";
import { createContent } from "@pzz-cms/core";
import AdminLayout from "../../../layouts/AdminLayout.astro";

const content = createContent(env.DB);
const id = Astro.params.id ?? "";
const document = await content.getDocumentById(id);

if (!document) {
  Astro.response.status = 404;
}

const initial = document
  ? {
      id: document.id,
      slug: document.slug,
      title: document.title,
      description: document.description,
      bodyJson: document.bodyJson,
      status: document.status,
    }
  : null;
---

<AdminLayout title={initial ? initial.title : "Document"}>
    {
        initial ? (
            <div class="space-y-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center gap-2 text-sm text-muted-foreground">
                        <a href="/admin/documents/" class="hover:underline">
                            Documents
                        </a>
                        <svg
                            viewBox="0 0 24 24"
                            class="h-3.5 w-3.5"
                            aria-hidden="true"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path d="m9 18 6-6-6-6" />
                        </svg>
                        <span class="max-w-[420px] truncate font-medium text-foreground">{initial.title}</span>
                    </div>
                </div>
                <DocumentEditor client:only="react" initial={initial} />
            </div>
        ) : (
            <div>
                <h1 class="text-2xl font-semibold">Document introuvable</h1>
                <a href="/admin/documents/" class="mt-4 inline-block text-sm hover:underline">
                    ← Retour aux documents
                </a>
            </div>
        )
    }
</AdminLayout>
