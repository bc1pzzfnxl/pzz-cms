---
import { ClientRouter } from "astro:transitions";
import { env } from "cloudflare:workers";
// src/layouts/MainLayout.astro
import { Icon } from "astro-icon/components";
import "../styles/fonts.css";
import "../styles/global.css";
import { createContent, type SiteTheme, site } from "@pzz-cms/core";

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  image?: string;
  imageSrcSet?: string;
  imageSizes?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description = site.description,
  ogType = "website",
  image = site.defaultCover,
  imageSrcSet,
  imageSizes,
  publishedTime,
  modifiedTime,
} = Astro.props;

const content = createContent(env.DB);
const theme: SiteTheme = await content.getTheme();

/** Six tokens per mode, exposed to CSS as the --site-* custom properties. */
const themeVars = (palette: SiteTheme["light"]) =>
  `--site-bg:${palette.background};--site-text:${palette.text};--site-heading:${palette.heading};--site-muted:${palette.muted};--site-border:${palette.border};--site-link:${palette.link};`;
const themeCss = `:root{${themeVars(theme.light)}}html.dark-mode{${themeVars(theme.dark)}}`;

const siteTitle = site.name;
const fullTitle = title === "Home" ? `${siteTitle} | ${site.tagline}` : `${title} | ${siteTitle}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang={site.locale}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <!-- Favicons & Touch Icons -->
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

        <!-- Preload the above-the-fold font (core subset only) so the swap
             happens before paint. The extended file loads on demand. -->
        <link rel="preload" href="/fonts/geist-sans-core.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

        <!-- Preload LCP Image -->
        {image && (
            <link
                rel="preload"
                as="image"
                href={image}
                imagesrcset={imageSrcSet}
                imagesizes={imageSizes}
                fetchpriority="high"
            />
        )}

        <!-- Primary Meta Tags -->
        <title>{fullTitle}</title>
        <meta name="title" content={fullTitle} />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />

        <!-- RSS discovery: lets search engines and aggregators find the feed. -->
        <link
            rel="alternate"
            type="application/rss+xml"
            title={site.name}
            href={new URL("rss.xml", Astro.site)}
        />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={image} />
        {publishedTime && <meta property="article:published_time" content={publishedTime} />}
        {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={fullTitle} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={image} />

        <ClientRouter />
        <script is:inline>
            (function() {
                const theme = localStorage.getItem('theme');
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                const isDark = theme === 'dark' || (!theme && prefersDark);
                if (isDark) {
                    document.documentElement.classList.add('dark-mode');
                }
            })();
        </script>
        <style is:inline set:html={themeCss}></style>
        <style is:global>
            :root {
                --body-font: 'Geist Variable', -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
                --mono-font: 'Geist Mono', monospace;
            }

            body {
                max-width: 680px;
                margin: 0 auto;
                padding: 60px 24px;
                font-family: var(--body-font);
                font-size: 18px;
                line-height: 1.65;
                color: var(--site-text);
                background-color: var(--site-bg);
                transition: background-color 0.3s ease, color 0.3s ease;
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
            }

            header {
                margin-bottom: 80px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            .header-left {
                display: flex;
                align-items: center;
            }

            h1, h2, h3, h4, .site-title a {
                color: var(--site-heading);
                font-weight: 600;
                letter-spacing: -0.02em;
                line-height: 1.25;
            }

            h1.site-title a {
                text-decoration: none;
                font-size: 1.25rem;
            }

            .theme-toggle-button {
                background: none;
                border: none;
                cursor: pointer;
                padding: 5px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                opacity: 0.7;
                transition: opacity 0.2s ease;
            }
            .theme-toggle-button:hover {
                opacity: 1;
            }
            .theme-toggle-button .icon {
                width: 22px;
                height: 22px;
                color: var(--site-heading);
            }

            a {
                color: var(--site-link);
                text-decoration: underline;
                text-decoration-thickness: 1.5px;
                text-underline-offset: 4px;
                transition: color 0.2s ease, background-color 0.2s ease;
            }
            a:hover {
                background-color: var(--site-link);
                color: var(--site-bg);
                text-decoration: none;
            }

            ul {
                list-style: none;
                padding: 0;
            }
            li {
                margin-bottom: 16px;
                display: flex;
                align-items: baseline;
            }
            .article-footer {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-top: 60px;
            }
            .article-footer .back-link {
                margin-top: 0;
            }
            .article-footer .modified-date {
                font-size: 0.85rem;
                color: var(--site-muted);
            }
            .back-link {
                display: inline-block;
                margin-top: 60px;
                font-size: 0.95rem;
                opacity: 0.6;
            }

            /* --- Footer (all pages) --- */
            .site-footer {
                margin-top: 4rem;
                padding-top: 1.5rem;
                border-top: 1px solid var(--site-border);
                font-size: 0.85rem;
                color: var(--site-muted);
                display: flex;
                flex-wrap: wrap;
                gap: 0.5rem 1.5rem;
                align-items: baseline;
            }
            .site-footer a {
                color: var(--site-muted);
            }

            /* --- Breadcrumb --- */
            .breadcrumb {
                font-size: 0.85rem;
                color: var(--site-muted);
                margin-bottom: 1rem;
                display: flex;
                flex-wrap: wrap;
                align-items: baseline;
                gap: 0.35rem;
            }
            .breadcrumb a {
                color: var(--site-muted);
            }
            .breadcrumb span {
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                max-width: 100%;
            }

            /* --- Table of contents (Sommaire) --- */
            .article-toc {
                margin: 2rem 0 2.5rem 0;
                padding: 1.25rem 1.5rem;
                border: 1px solid var(--site-border);
                border-radius: 8px;
            }
            .article-toc-title {
                font-size: 0.8rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                font-weight: 600;
                color: var(--site-muted);
                margin-bottom: 0.75rem;
            }
            .site-reading .article-toc ul {
                list-style: none;
                padding: 0;
                margin: 0;
            }
            .site-reading .article-toc li {
                display: block;
                margin-bottom: 0.5rem;
                font-size: 0.95rem;
            }
            .site-reading .article-toc li:last-child {
                margin-bottom: 0;
            }
            .site-reading .article-toc li.toc-h3 {
                padding-left: 1.25rem;
                font-size: 0.9rem;
            }

            /* --- Reading typography --- */
            h1,
            h2,
            h3,
            h4 {
                text-wrap: balance;
            }
            p,
            li {
                text-wrap: pretty;
            }
            article {
                hyphens: auto;
                -webkit-hyphens: auto;
            }

            .moon-icon { display: none; }
            .sun-icon { display: block; }
            html.dark-mode .moon-icon { display: block; }
            html.dark-mode .sun-icon { display: none; }
        </style>
    </head>
    <body>
        <header>
            <div class="header-left">
                {title === "Home" ? (
                    <h1 class="site-title"><a href="/">{siteTitle}</a></h1>
                ) : (
                    <div class="site-title"><a href="/">{siteTitle}</a></div>
                )}
            </div>
            <button class="theme-toggle-button" id="theme-toggle" aria-label="Changer de thème">
                <Icon name="heroicons-solid:sun" class="sun-icon icon" />
                <Icon name="heroicons-solid:moon" class="moon-icon icon" />
            </button>
        </header>
        <main>
            <slot />
        </main>
        <footer class="site-footer">
            <span>© {new Date().getFullYear()} {site.name}</span>
            {site.contactEmail && <a href={`mailto:${site.contactEmail}`}>Contact</a>}
            <a href="/rss.xml">RSS</a>
        </footer>
        <script>
            document.addEventListener('click', (event) => {
                if (event.target instanceof Element) {
                    const themeToggle = event.target.closest('#theme-toggle');
                    if (themeToggle) {
                        const isDarkMode = document.documentElement.classList.toggle('dark-mode');
                        localStorage.setItem('theme', isDarkMode ? 'dark' : 'light');
                    }
                }
            });
        </script>
    </body>
</html>