---
import { ClientRouter } from "astro:transitions";
// src/layouts/MainLayout.astro
import { Icon } from "astro-icon/components";
import "@fontsource/geist-mono/400.css";
import geistVariable from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import "../styles/global.css";
import { site } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  image?: string;
  imageSrcSet?: string;
  imageSizes?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description = site.description,
  ogType = "website",
  image = site.defaultCover,
  imageSrcSet,
  imageSizes,
  publishedTime,
  modifiedTime,
} = Astro.props;

const siteTitle = site.name;
const fullTitle = title === "Home" ? `${siteTitle} | ${site.tagline}` : `${title} | ${siteTitle}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang={site.locale}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <!-- Favicons & Touch Icons -->
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

        <!-- Preload the above-the-fold font so the swap happens before paint -->
        <link rel="preload" href={geistVariable} as="font" type="font/woff2" crossorigin="anonymous" />

        <!-- Preload LCP Image -->
        {image && (
            <link
                rel="preload"
                as="image"
                href={image}
                imagesrcset={imageSrcSet}
                imagesizes={imageSizes}
                fetchpriority="high"
            />
        )}

        <!-- Primary Meta Tags -->
        <title>{fullTitle}</title>
        <meta name="title" content={fullTitle} />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={image} />
        {publishedTime && <meta property="article:published_time" content={publishedTime} />}
        {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={fullTitle} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={image} />

        <ClientRouter />
        <script is:inline>
            (function() {
                const theme = localStorage.getItem('theme');
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                const isDark = theme === 'dark' || (!theme && prefersDark);
                if (isDark) {
                    document.documentElement.classList.add('dark-mode');
                }
            })();
        </script>
        <style is:global>
            :root {
                --body-font: 'Geist Variable', -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
                --mono-font: 'Geist Mono', monospace;
            }

            body {
                max-width: 680px;
                margin: 0 auto;
                padding: 60px 24px;
                font-family: var(--body-font);
                font-size: 18px;
                line-height: 1.65;
                color: #374151;
                background-color: #ffffff;
                transition: background-color 0.3s ease, color 0.3s ease;
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
            }

            header {
                margin-bottom: 80px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            .header-left {
                display: flex;
                align-items: center;
            }

            h1, h2, h3, h4, .site-title a {
                color: #111827;
                font-weight: 600;
                letter-spacing: -0.02em;
                line-height: 1.25;
            }

            h1.site-title a {
                text-decoration: none;
                font-size: 1.25rem;
            }

            .theme-toggle-button {
                background: none;
                border: none;
                cursor: pointer;
                padding: 5px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                opacity: 0.7;
                transition: opacity 0.2s ease;
            }
            .theme-toggle-button:hover {
                opacity: 1;
            }
            .theme-toggle-button .icon {
                width: 22px;
                height: 22px;
                color: #111;
            }

            a {
                color: #111;
                text-decoration: underline;
                text-decoration-thickness: 1.5px;
                text-underline-offset: 4px;
                transition: color 0.2s ease, background-color 0.2s ease;
            }
            a:hover {
                background-color: #111;
                color: #fff;
                text-decoration: none;
            }

            ul {
                list-style: none;
                padding: 0;
            }
            li {
                margin-bottom: 16px;
                display: flex;
                align-items: baseline;
            }

            article h3 {
                font-size: 1.25rem;
                margin-top: 2.5rem;
                margin-bottom: 0.75rem;
            }
            article h4 {
                font-size: 1.05rem;
                margin-top: 1.75rem;
                margin-bottom: 0.5rem;
            }
            article p {
                margin-bottom: 1.75rem;
            }
            article table {
                width: 100%;
                border-collapse: separate;
                border-spacing: 0;
                margin: 1.25rem 0 2rem 0;
                font-size: 0.95rem;
                line-height: 1.6;
                border: 1px solid #e5e7eb;
                border-radius: 8px;
                overflow: hidden;
            }
            article th, article td {
                padding: 12px 16px;
                text-align: left;
                vertical-align: top;
            }
            article th {
                font-size: 0.8rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                font-weight: 600;
                color: #4b5563;
                background-color: #f9fafb;
                border-bottom: 1px solid #e5e7eb;
            }
            article td {
                border-bottom: 1px solid #f3f4f6;
            }
            article tr:last-child td {
                border-bottom: none;
            }
            article tr:nth-child(even) td {
                background-color: #fafafa;
            }
            article blockquote {
                margin: 1.25rem 0 2rem 0;
                padding: 1.25rem 1.5rem;
                border-left: 3px solid #111827;
                background-color: #f9fafb;
                border-radius: 0 8px 8px 0;
                font-size: 1rem;
                line-height: 1.5;
            }
            article blockquote p {
                margin-bottom: 1.1rem;
            }
            article blockquote p:last-child {
                margin-bottom: 0;
            }
            article blockquote strong {
                display: block;
                color: #111827;
                font-weight: 600;
                font-size: 1rem;
            }
            article blockquote em {
                display: block;
                color: #6b7280;
                font-style: italic;
                font-size: 0.92rem;
                margin-top: 0.2rem;
            }
            article ul {
                list-style: disc;
                padding-left: 24px;
                margin-bottom: 2rem;
            }
            article h1 {
                font-size: 2.25rem;
                margin-top: 2rem;
                margin-bottom: 1rem;
            }
            article h2 {
                font-size: 1.75rem;
                margin-top: 2.5rem;
                margin-bottom: 0.75rem;
            }
            article li {
                display: list-item;
                margin-bottom: 0.75rem;
            }
            article img {
                width: 100%;
                max-width: 100%;
                height: auto;
                border-radius: 8px;
                margin: 1.5rem 0 2rem 0;
                display: block;
            }
            .article-cover-wrapper {
                margin: 1rem 0 2rem 0;
                width: 100%;
                text-align: center;
            }
            .article-cover {
                width: auto;
                max-width: 100%;
                height: auto;
                max-height: 550px;
                border-radius: 8px;
                margin: 0 auto;
                display: block;
            }
            .article-cover-caption {
                font-size: 0.85rem;
                color: #6b7280;
                margin-top: 0.5rem;
                text-align: center;
                font-style: italic;
            }
            .article-figure {
                margin: 1.5rem 0 2rem 0;
            }
            .article-figure img {
                margin: 0;
            }
            .article-caption {
                font-size: 0.85rem;
                line-height: 1.5;
                color: #6b7280;
                margin-top: 0.5rem;
                text-align: center;
            }
            .article-meta {
                font-size: 0.9rem;
                color: #6b7280;
                margin-top: -0.5rem;
                margin-bottom: 1.5rem;
            }
            .article-footer {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-top: 60px;
            }
            .article-footer .back-link {
                margin-top: 0;
            }
            .article-footer .modified-date {
                font-size: 0.85rem;
                color: #6b7280;
            }
            .back-link {
                display: inline-block;
                margin-top: 60px;
                font-size: 0.95rem;
                opacity: 0.6;
            }
            
            html.dark-mode body {
                background-color: #111111; 
                color: #d1d5db;
            }
            html.dark-mode .article-cover-caption,
            html.dark-mode .article-caption,
            html.dark-mode .article-meta,
            html.dark-mode .article-footer .modified-date {
                color: #9ca3af;
            }
            html.dark-mode h1, 
            html.dark-mode h2, 
            html.dark-mode h3, 
            html.dark-mode h4,
            html.dark-mode h1.site-title a,
            html.dark-mode a {
                color: #ffffff;
            }
            html.dark-mode a:hover {
                background-color: #ffffff;
                color: #111;
            }
            html.dark-mode .theme-toggle-button .icon {
                color: #fff;
            }
            html.dark-mode article table {
                border-color: #27272a;
            }
            html.dark-mode article th {
                color: #a1a1aa;
                background-color: #18181b;
                border-bottom-color: #27272a;
            }
            html.dark-mode article td {
                border-bottom-color: #27272a;
            }
            html.dark-mode article tr:nth-child(even) td {
                background-color: #141416;
            }
            html.dark-mode article blockquote {
                border-left-color: #e5e7eb;
                background-color: #161618;
            }
            html.dark-mode article blockquote strong {
                color: #f3f4f6;
            }
            html.dark-mode article blockquote em {
                color: #9ca3af;
            }
            .moon-icon { display: none; }
            .sun-icon { display: block; }
            html.dark-mode .moon-icon { display: block; }
            html.dark-mode .sun-icon { display: none; }
        </style>
    </head>
    <body>
        <header>
            <div class="header-left">
                {title === "Home" ? (
                    <h1 class="site-title"><a href="/">{siteTitle}</a></h1>
                ) : (
                    <div class="site-title"><a href="/">{siteTitle}</a></div>
                )}
            </div>
            <button class="theme-toggle-button" id="theme-toggle" aria-label="Changer de thème">
                <Icon name="heroicons-solid:sun" class="sun-icon icon" />
                <Icon name="heroicons-solid:moon" class="moon-icon icon" />
            </button>
        </header>
        <main>
            <slot />
        </main>
        <script>
            document.addEventListener('click', (event) => {
                if (event.target instanceof Element) {
                    const themeToggle = event.target.closest('#theme-toggle');
                    if (themeToggle) {
                        const isDarkMode = document.documentElement.classList.toggle('dark-mode');
                        localStorage.setItem('theme', isDarkMode ? 'dark' : 'light');
                    }
                }
            });
        </script>
    </body>
</html>