---
import MainLayout from "../layouts/MainLayout.astro";
import { site } from "../lib/site";

const siteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  description: site.description,
  inLanguage: site.locale,
  publisher: {
    "@type": "Person",
    name: site.author.name,
    url: site.author.url,
    image: site.logo,
    logo: {
      "@type": "ImageObject",
      url: site.logo,
    },
  },
};
---

<MainLayout title="Home">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(siteSchema)} />
    <section>
        <h2 style="font-size: 0.9rem; text-transform: uppercase; color: #666; margin-bottom: 20px;">
            Articles
        </h2>
        <p>Aucun article pour le moment.</p>
    </section>
</MainLayout>
